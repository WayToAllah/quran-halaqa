rules_version = '2';

// ============================================================================
// متابعة حفظ القرآن — Firestore Security Rules (Phase 2)
//
// Model: mosques/{mosqueId} owns halaqat/{halaqaId}, which owns its own
// students/records. Access to everything under a mosque requires a
// members/{uid} doc under that mosque — there is no blanket "any signed-in
// user can read/write anything" rule like the old RTDB `auth != null` grant.
//
// publicStats/{token} is the one deliberately public read exception:
// child.html reads a single doc by a high-entropy token, with no sign-in at
// all. `get` is allowed, `list` is denied (tokens can never be enumerated).
//
// WRITE to publicStats requires actual mosque membership — NOT merely being
// signed in. This project has Anonymous auth enabled and email/password
// self-signup reachable via the public Auth REST API, so `request.auth != null`
// would effectively mean "anyone", and a parent knows their own child's token
// from the WhatsApp link. This is still a TRANSITIONAL grant: Phase 5 moves the
// write into a Cloud Function and flips it to `write: if false` so no client can
// write it at all. Tracked in PROJECT_CONTEXT.md.
//
// Verify with the Rules Playground in Firebase Console, or (preferred, and
// what the CI workflow in .github/workflows/ci.yml runs automatically)
// `firebase emulators:exec` against firestore.rules.test.ts.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Anonymous auth is enabled for the parent page, and email/password
    // self-signup is reachable through the public Auth REST API. So "signed in"
    // is not a meaningful bar for creating anything — an anonymous visitor must
    // never be able to stand up a mosque.
    function isRealUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Deliberately UNCHANGED: still exactly one exists() lookup. This runs on
    // every student and record access, and rules lookups are billed reads, so
    // adding an ownerUid fallback here would quietly double the cost of the
    // busiest path in the app. The owner gets a real members/{uid} document
    // instead, written immediately after the mosque (see isMosqueOwner).
    function isMosqueMember(mosqueId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/mosques/$(mosqueId)/members/$(request.auth.uid));
    }

    // Only used on the rare administrative writes below, never on a read path.
    function isMosqueOwner(mosqueId) {
      return isRealUser() &&
        exists(/databases/$(database)/documents/mosques/$(mosqueId)) &&
        get(/databases/$(database)/documents/mosques/$(mosqueId)).data.ownerUid == request.auth.uid;
    }

    function isValidMosqueName(name) {
      return name is string && name.size() > 0 && name.size() <= 80;
    }

    match /mosques/{mosqueId} {
      allow read: if isMosqueMember(mosqueId);

      // A teacher creates their own mosque from inside the app. This is the one
      // self-authorising write in the whole model: the document names its own
      // owner, and every administrative write below is then authorised by
      // reading it back. That is what removes the need for a Cloud Function —
      // rules evaluate each write in a batch independently, so two documents
      // that had to appear together atomically would have required a server.
      //
      // The shape is pinned so the document cannot be used for anything else,
      // and `id` must match the path so the stored id can never disagree with
      // where the document actually lives.
      allow create: if isRealUser()
        && request.resource.data.keys().hasOnly(['id', 'name', 'createdAt', 'ownerUid'])
        && request.resource.data.keys().hasAll(['id', 'name', 'ownerUid'])
        && request.resource.data.id == mosqueId
        && request.resource.data.ownerUid == request.auth.uid
        && isValidMosqueName(request.resource.data.name);

      // Renaming is fine; handing the mosque to someone else, or changing which
      // document this is, is not.
      allow update: if isMosqueOwner(mosqueId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == resource.data.id
        && isValidMosqueName(request.resource.data.name);

      // Deleting a mosque would orphan every student, record and parent link
      // under it with no way to reach them again.
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMosqueMember(mosqueId);
        // Only the owner grants access, and only ever a role — never arbitrary
        // data. The owner writes their own entry here right after creating the
        // mosque; if that second write is lost, they can simply retry, because
        // this rule is authorised by ownerUid on the mosque, not by membership.
        allow create, update: if isMosqueOwner(mosqueId)
          && request.resource.data.keys().hasOnly(['role'])
          && request.resource.data.role in ['owner', 'admin'];
        allow delete: if isMosqueOwner(mosqueId);
      }

      match /halaqat/{halaqaId} {
        allow read, write: if isMosqueMember(mosqueId);

        match /students/{studentId} {
          allow read, write: if isMosqueMember(mosqueId);
        }

        match /records/{recordId} {
          allow read, write: if isMosqueMember(mosqueId);
        }
      }
    }

    // `users/{uid}` is a LOOKUP INDEX, never a grant. Firestore cannot answer
    // "which mosques is this uid a member of" — members/{uid} lives under each
    // mosque and there is no cross-collection query for it — so each account
    // keeps its own list of mosque ids here.
    //
    // The owner writes it themselves (a teacher creating their own mosque adds
    // their own entry), which means the contents are untrusted: an account can
    // list a mosque it has no membership in. That buys nothing — reading
    // mosques/{id} still requires a real members/{uid} document, so a forged
    // entry just drops out of the picker. Nothing may ever treat presence in
    // this list as proof of access.
    //
    // The shape is pinned so the document cannot be used as free storage, and
    // capped so it cannot fan out into hundreds of reads on the client (see
    // MAX_INDEXED_MOSQUES in src/domain/memberships.ts).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mosqueIds'])
        && request.resource.data.mosqueIds is list
        && request.resource.data.mosqueIds.size() <= 50;
    }

    match /publicStats/{token} {
      allow get: if true;
      allow list: if false;
      // Transitional: the admin app writes the projection; moves to a Cloud
      // Function (write: if false) in Phase 5.
      //
      // ⚠️ Deliberately NOT `isSignedIn()`: this Firebase project has the
      // Anonymous auth provider enabled (production parent-form.html uses it),
      // and email/password self-signup is reachable via the public Auth REST
      // API — so "any signed-in user" effectively means "anyone". A parent
      // knows their own token from the WhatsApp link and could overwrite
      // their child's published stats. Writes therefore require actual
      // mosque membership.
      //
      // The mosque id is hardcoded because publicStats/{token} carries no
      // mosque context by design (see publicStats.repo.ts). Single tenant
      // today (mirrors MOSQUE_ID in src/config.ts); Phase 5 removes client
      // writes entirely, so this never needs to become multi-tenant.
      allow write: if isMosqueMember('altayseer');
    }
  }
}
